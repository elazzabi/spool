{
  "name": "spool",
  "version": "0.1.2",
  "private": true,
  "description": "A Markdown-native control plane for local AI agents",
  "keywords": [
    "ai-agents",
    "automation",
    "cli",
    "markdown",
    "obsidian"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/elazzabi/spool#readme",
  "bugs": {
    "url": "https://github.com/elazzabi/spool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elazzabi/spool.git"
  },
  "type": "module",
  "bin": {
    "spool": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "examples/providers/fake-agent.mjs",
    "examples/spool.config.yaml",
    "examples/vault",
    "examples/repos/README.md",
    "scripts/smoke-providers.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@11.15.0",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:recovery": "vitest run tests/integration/recovery.test.ts tests/e2e/provider-smoke.test.ts",
    "test:runtime": "npm run build && node scripts/test-package.mjs",
    "test:release": "vitest run tests/e2e/release-artifact.test.ts",
    "release:artifact": "npm run build && node scripts/build-release.mjs artifact",
    "release:manifest": "node scripts/build-release.mjs manifest",
    "release:validate-tag": "node scripts/build-release.mjs validate-tag",
    "release:verify": "node scripts/test-release.mjs --manifest release/release-manifest.json --daemon-lock true",
    "doctor": "node dist/cli/index.js doctor",
    "smoke:providers": "npm run build && node scripts/smoke-providers.mjs",
    "check:source": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "check": "npm run check:source && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "better-sqlite3": "^12.11.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  }
}
